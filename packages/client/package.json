{
  "name": "@netiflyjs/client",
  "version": "0.0.0",
  "description": "Zero-dependency browser/Node WebSocket client for Netifly — reconnects with full-jitter backoff and typed event handlers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NetiflyJS/netifly.git",
    "directory": "packages/client"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "dependencies": {},
  "devDependencies": {
    "@netiflyjs/core": "workspace:*",
    "@size-limit/esbuild": "^11.1.4",
    "@size-limit/file": "^11.1.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "size-limit": "^11.1.4",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.4"
  },
  "size-limit": [
    {
      "name": "dist/index.js, bundled + minified + gzipped",
      "path": "dist/index.js",
      "limit": "3 KB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
